# 复制为 .env 后填写真实值；.env 不入库（已在 .gitignore）
# 只有这 4 项是"必须知道"的，其余用默认值即可跑起演示

# 数据库是 SQLite 文件，默认 backend/data/haofangzi.db。需要换位置时再设：
# SQLITE_PATH=./data/haofangzi.db

# 令牌签名密钥（≥32 字符）。演示可留默认，校内展评请改
JWT_SECRET=demo-only-please-change-me-32bytes!!

# 大模型：留空或 LLM_ENABLED=false 时全部能力走 MockLlmClient 模板结果（断网可演示，AC-66）
# 默认硅基流动 OpenAI 兼容接口；密钥只写本机 .env，不要提交
LLM_ENABLED=true
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=XingChenAGI/Xing4.0-29B
LLM_TIMEOUT_MS=20000
LLM_API_KEY=
