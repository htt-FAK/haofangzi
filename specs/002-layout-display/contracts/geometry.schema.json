{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haofangzi.zhq/specs/002/geometry.schema.json",
  "title": "户型几何数据契约 HouseTypeGeometry",
  "description": "002 展示（2D/3D）与 004 评分共用的唯一几何来源；坐标单位米，原点为包围盒西北角。前后端与 AI 生成 3D 代码均以此为准。",
  "type": "object",
  "required": ["code", "orientation", "bay", "depth", "ceiling", "outline", "rooms"],
  "additionalProperties": false,
  "properties": {
    "code": { "type": "string" },
    "orientation": { "enum": ["S", "SE", "SW", "E", "W", "N", "NS"], "description": "户型主朝向；NS=南北通透" },
    "bay": { "type": "number", "exclusiveMinimum": 0, "description": "面宽（东西向总宽）m" },
    "depth": { "type": "number", "exclusiveMinimum": 0, "description": "进深（南北向总深）m" },
    "ceiling": { "type": "number", "minimum": 2.2, "maximum": 6 },
    "gfa": { "type": "number" },
    "privateArea": { "type": "number" },
    "outline": {
      "type": "array", "minItems": 4,
      "description": "外墙轮廓折线，顺时针闭合（末点与首点重合由程序补）",
      "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
    },
    "rooms": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["name", "category", "x", "y", "w", "h", "area"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 32 },
          "category": { "enum": ["LIVING", "DINING", "MASTER", "SECOND", "STUDY", "KITCHEN", "BATH", "BALCONY", "CORRIDOR", "UTILITY", "ENTRY"] },
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 },
          "w": { "type": "number", "exclusiveMinimum": 0 },
          "h": { "type": "number", "exclusiveMinimum": 0 },
          "area": { "type": "number", "exclusiveMinimum": 0, "description": "必须满足 |area - w*h| ≤ 5%（AC-15 校验）" },
          "orientation": { "enum": ["S", "N", "E", "W", "NE", "NW", "SE", "SW", "NONE"] },
          "windowArea": { "type": "number", "minimum": 0, "description": "外窗洞口面积 ㎡；0 → 暗房间（LIGHT_dark_bath 等指标输入）" },
          "windowOpenableRatio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
          "doors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y", "width"],
              "additionalProperties": false,
              "properties": {
                "x": { "type": "number" }, "y": { "type": "number" },
                "width": { "type": "number", "minimum": 0.6, "maximum": 2.4 },
                "wall": { "enum": ["N", "S", "E", "W"], "default": "S" },
                "swing": { "enum": ["NW", "NE", "SW", "SE"], "description": "门开启方向，用于动线可达性判定" }
              }
            }
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "width"],
              "additionalProperties": false,
              "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "wall": { "enum": ["N", "S", "E", "W"] }, "sill": { "type": "number", "default": 0.9 } }
            }
          }
        }
      }
    },
    "panoramas": {
      "type": "array",
      "description": "720° 全景视点（FR-18）",
      "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "target": { "type": "array", "items": { "type": "number" } } }, "additionalProperties": false }
    },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "ext": { "type": "object", "additionalProperties": true, "description": "扩展位：storageWallLen（收纳墙长度）、irrRatio、精装标准等，供 004 指标使用" }
  }
}
